# Netlify > Environment variables (production). Never commit real values to Git.
SITE_ORIGIN=https://francoroute.com
ADMIN_EMAILS=nellyfolefack6@gmail.com

# Supabase: project URL, publishable API key, Transaction pooler connection string.
# All variables below are server-side only. Do not prefix them with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Optional: Supabase root CA PEM if required by your selected database endpoint.
# Real newlines or literal \n are both accepted. Certificate verification stays enabled.
DATABASE_CA_CERT=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Choose deliberately: inclusive (taxes included), exclusive (added), none (not collected).
PAYMENT_TAX_MODE=

RESEND_API_KEY=
# Use a sender on your verified Resend domain; not an @outlook.com sender.
BOOKING_MAIL_FROM=
BOOKING_NOTIFY_EMAIL=francoroute@outlook.com
